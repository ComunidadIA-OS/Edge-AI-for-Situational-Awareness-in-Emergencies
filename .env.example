# ============================================================
# Heimdall Ground Control — environment variables (template)
# ============================================================
# Copy this file to .env.local for local development.
# Values below are placeholders — use real values in your env.
# ============================================================

# Base URL of the Jetson AGX (drone REST API)
# Local dev:   http://localhost:3001 (uses MSW mocks)
# Lab:         http://192.168.1.100:8000
# Field:       https://jetson-field-01.starlink.mil
NEXT_PUBLIC_JETSON_URL=http://localhost:3001

# Map tiles token (MapLibre GL)
# Leave empty to use public OSM tiles (free, lower resolution)
# For satellite tiles: MapTiler, Mapbox, or Stadia Maps
NEXT_PUBLIC_MAPBOX_TOKEN=

# NASA FIRMS API key (MODIS/VIIRS satellite hotspots)
# Optional — if omitted, the FIRMS layer is disabled
# Get one at: https://firms.modaps.eosdis.nasa.gov/api/map_key/
NEXT_PUBLIC_FIRMS_API_KEY=

# Next.js sets this automatically based on the command:
#   pnpm dev    → development
#   pnpm build  → production
#   pnpm start  → production
NODE_ENV=development
