.secrets/
*.csv
.env
*.pem
*.key

# Datasets and data (do not commit — use S3)
datasets/
/data/

# Allow test fixtures inside tests/
!tests/data/

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
venv/

# YOLO training artifacts and model weights (download from S3 on Jetson)
runs/
weights/
*.pt
*.engine
*.onnx
wandb/

# docker/.env (never commit — use .env.example)
docker/.env

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
Thumbs.db
Desktop.ini
.DS_Store

# Jupyter
.ipynb_checkpoints/

# S3 sync / AWS artifacts
s3/

