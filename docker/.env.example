# XHeimdall Convergence API — environment template
# Copy to docker/.env and adjust. Never commit the real .env.

# --- Identity ---
# One process == one drone. Use a stable identifier per device.
DRONE_ID=drone-0

# --- Server ---
HOST_PORT=8000
LOG_LEVEL=info
# Comma-separated origins for the frontend, or "*" during the sprint.
CORS_ORIGINS=*

# --- Pipeline tuning ---
# Ring-buffer length for area-history derivatives (>=3).
HISTORY_SIZE=30
# Seconds between background re-runs of the meteo analysis using the last
# known detection. 0 disables the loop (analysis only runs on POST /detect).
REFRESH_SECONDS=60
# Hours of hourly forecast to fetch from Open-Meteo (max 240).
FORECAST_HOURS=24
