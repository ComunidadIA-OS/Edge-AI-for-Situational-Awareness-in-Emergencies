# Heimdall edge — environment template
# Copy to docker/.env and adjust. Never commit the real .env.
#
#   cp docker/.env.example docker/.env

# ── Identity ──────────────────────────────────────────────────────────────────
# One process == one drone. Use a stable identifier per device.
DRONE_ID=drone-0

# ── Convergence API server ────────────────────────────────────────────────────
HOST_PORT=8000
LOG_LEVEL=info
# Comma-separated origins for the frontend, or "*" during the sprint.
CORS_ORIGINS=*

# ── Pipeline tuning ───────────────────────────────────────────────────────────
# Ring-buffer length for area-history derivatives (>=3).
HISTORY_SIZE=30
# Seconds between background re-runs of the meteo analysis.
# 0 disables the loop (analysis only runs on POST /detect).
REFRESH_SECONDS=60
# Hours of hourly forecast to fetch from Open-Meteo (max 240).
FORECAST_HOURS=24

# ── Drone telemetry defaults (vision inference container) ─────────────────────
# Override with real GPS coordinates when deploying in the field.
DRONE_LAT=41.6837
DRONE_LON=-0.8881
DRONE_ALT_M=120
DRONE_HEADING=0

# ── Camera ────────────────────────────────────────────────────────────────────
CAMERA_DEVICE=/dev/video0
CAMERA_SOURCE=/dev/video0
# GStreamer pipeline template: flir_boson | v4l2 | rtsp
CAMERA_TEMPLATE=flir_boson

# ── TensorRT model ────────────────────────────────────────────────────────────
# Path *inside* the container (mounted from ../models via the compose volume).
MODEL_ENGINE_PATH=/models/best.engine

# ── Audible alerts (Jetson GPIO buzzer) ───────────────────────────────────────
# Physical pin number (BOARD mode). Connect buzzer positive to this pin
# and negative to GND. Set to 0 to disable GPIO and fall back to ALSA.
BUZZER_GPIO_PIN=7
# Duration of each beep in seconds.
CRITICAL_BEEP_DURATION_S=0.6

# ── Vision inference supervisor ───────────────────────────────────────────────
HEALTHCHECK_INTERVAL=5
MAX_RESTARTS=5
